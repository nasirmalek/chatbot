{
  "version": 2,
  "builds": [
    {
      "src": "django_chatbot/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "django_chatbot/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "django_chatbot.settings"
  }
}